# =========================================================
# IDENTITAS
# =========================================================
APP_ENV=production
APP_NAME=oil-spill-monitor
SITE_ID=jetty-01
SITE_NAME="Jetty 01"
CAMERA_ID=cam-01
CAMERA_NAME=CAM-01
TIMEZONE=Asia/Singapore

# =========================================================
# VIDEO: rtsp atau file
# Untuk tes awal, ubah ke file dan isi VIDEO_FILE_PATH.
# =========================================================
VIDEO_SOURCE_TYPE=rtsp
RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.1.64:554/Streaming/Channels/102
RTSP_TRANSPORT=tcp
CAMERA_RECONNECT_SECONDS=5
CAMERA_STALE_SECONDS=15
VIDEO_FILE_PATH=/opt/oil-spill-monitor/data/test-video.mp4
VIDEO_LOOP=true

# Polygon ROI ternormalisasi. Kosong = seluruh frame.
# Contoh: ROI_POLYGON=0.05,0.30;0.95,0.30;0.95,0.95;0.05,0.95
ROI_POLYGON=

# =========================================================
# MODEL
# =========================================================
INFERENCE_BACKEND=onnx
ONNX_MODEL_PATH=/opt/oil-spill-monitor/models/best_model.onnx
HEF_MODEL_PATH=/opt/oil-spill-monitor/models/best_model.hef
MODEL_INPUT_WIDTH=1024
MODEL_INPUT_HEIGHT=576
PIXEL_THRESHOLD=0.55
AREA_THRESHOLD=0.0055
INFERENCE_INTERVAL_SECONDS=1
TEMPORAL_WINDOW_SIZE=5
POSITIVE_REQUIRED=3
NEGATIVE_TO_CLEAR=5
ONNX_INTRA_OP_THREADS=4
ONNX_INTER_OP_THREADS=1

# =========================================================
# PENYIMPANAN LOKAL
# =========================================================
EVIDENCE_DIRECTORY=/opt/oil-spill-monitor/data/evidence
SAVE_RAW_SNAPSHOT=true
SAVE_OVERLAY_SNAPSHOT=true
EVIDENCE_RETENTION_DAYS=30
DEBUG_SAVE_MASK=false
SQLITE_PATH=/opt/oil-spill-monitor/data/oil_spill.db
SYNC_RETRY_SECONDS=30
SYNC_MAX_RETRY_DELAY_SECONDS=600

# =========================================================
# FIREBASE REALTIME DATABASE
# =========================================================
FIREBASE_ENABLED=false
FIREBASE_DATABASE_URL=https://NAMA-PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
GOOGLE_APPLICATION_CREDENTIALS=/etc/oil-spill/firebase-service-account.json
FIREBASE_LIVE_PATH=/live/jetty-01/cam-01
FIREBASE_EVENT_LOG_PATH=/eventLogs
FIREBASE_INCIDENT_PATH=/incidents
HEARTBEAT_INTERVAL_SECONDS=60
DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_TIME=23:50

# =========================================================
# TELEGRAM
# =========================================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=GANTI_DENGAN_TOKEN_BARU
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_SEND_SNAPSHOT=true
TELEGRAM_SEND_RECOVERY=true
TELEGRAM_SEND_DAILY_NORMAL=true
DASHBOARD_URL=

# URL HTTPS yang dihasilkan Tailscale Funnel.
# Contoh: https://jetty01-pi.nama-tailnet.ts.net/jetty01/
HLS_PUBLIC_URL=

# =========================================================
# API LOKAL
# =========================================================
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=GANTI_DENGAN_NILAI_ACAK
CORS_ORIGINS=

# =========================================================
# LOG
# =========================================================
LOG_LEVEL=INFO
LOG_DIRECTORY=/opt/oil-spill-monitor/data/logs
LOG_RETENTION_DAYS=14
